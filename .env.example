# free-claude 配置文件
# 用法: cp .env.example .env  然后按需修改
# run.sh 与 trans_api.py 启动时会自动加载 .env

# =============================================================================
# API 服务
# =============================================================================

# 监听地址（默认仅本机，勿改为 0.0.0.0 除非你知道在做什么）
API_HOST=127.0.0.1

# 监听端口（Claude Code 的 ANTHROPIC_BASE_URL 需与此一致）
API_PORT=8000

# =============================================================================
# 项目上下文注入（服务端策略；项目目录由 Claude Code 请求自动识别）
# =============================================================================

# 是否注入项目代码上下文：1 开启 / 0 关闭
CONTEXT=1

# 注入模式：lite（README+关键文件+目录树）/ tree（仅目录树）/ full（尽量全量源码）
CONTEXT_MODE=lite

# 注入内容总字符上限（full 模式建议 30000）
CONTEXT_MAX_CHARS=20000

# 单文件最大字节数，超过则跳过
CONTEXT_MAX_FILE_BYTES=51200

# 额外忽略的目录名，逗号分隔（如 vendor,tmp）
CONTEXT_IGNORE=

# 是否每轮 API 都重新扫描项目：1 是 / 0 否（默认仅会话首轮）
CONTEXT_ALWAYS=0

# =============================================================================
# 凭证与请求可靠性
# =============================================================================

# 后台凭证健康检查间隔（秒）；0 表示关闭自动检查
CREDENTIAL_CHECK_INTERVAL=3600

# 网络失败时的最大重试次数
RETRY_MAX=3

# 重试基础延迟（秒），实际延迟指数递增
RETRY_BASE_DELAY=1.0

# 每个 provider 每分钟最大请求数；0 表示不限速
RATE_LIMIT_RPM=30

# 浏览器内 fetch 超时（毫秒）
FETCH_TIMEOUT_MS=180000

# =============================================================================
# 豆包（Doubao）
# =============================================================================

# 豆包聊天页 URL
DOUBAO_CHAT_URL=https://www.doubao.com/chat/

# 豆包 SSE 补全接口 URL
DOUBAO_COMPLETION_URL=https://www.doubao.com/chat/completion

# 默认 Bot ID
DOUBAO_BOT_ID=7338286299411103781

# 等待浏览器登录的最长时间（秒）
DOUBAO_LOGIN_WAIT_SEC=180

# =============================================================================
# DeepSeek
# =============================================================================

# DeepSeek 聊天页 URL
DEEPSEEK_CHAT_URL=https://chat.deepseek.com/

# DeepSeek 网页 API 前缀
DEEPSEEK_API_BASE=https://chat.deepseek.com/api/v0

# Chromium remote-debugging 端口（profile 被占用时 CDP 复用）
DEEPSEEK_DEBUG_PORT=9333

# 聊天 session 缓存 TTL（秒），减少 create_session 调用
DEEPSEEK_SESSION_TTL_SEC=300

# 是否复用 chat session：1 是 / 0 每次新建
DEEPSEEK_REUSE_SESSION=1

# 等待浏览器登录的最长时间（秒）
DEEPSEEK_LOGIN_WAIT_SEC=300

# PoW 求解 WASM 文件 URL
DEEPSEEK_POW_WASM_URL=https://fe-static.deepseek.com/chat/static/sha3_wasm_bg.7b9ca65ddd.wasm

# DeepSeek 网页端限流（比全局 RATE_LIMIT_RPM 更严；0=自动取 min(RATE_LIMIT_RPM, 12)）
DEEPSEEK_RATE_LIMIT_RPM=0

# 触发 rate_limit_reached 后的退避秒数（第 n 次重试等待 n * 该值）
DEEPSEEK_RATE_LIMIT_BACKOFF_SEC=30

# =============================================================================
# ChatGPT（浏览器登录 chatgpt.com）
# =============================================================================

# 聊天页 URL
CHATGPT_CHAT_URL=https://chatgpt.com/

# 网页 API 默认模型（gpt-4o / auto 等）
CHATGPT_MODEL=gpt-4o

# 等待浏览器登录的最长时间（秒）
CHATGPT_LOGIN_WAIT_SEC=300

# 无头模式：0=可见浏览器（推荐，避免 Unusual activity 风控）；1=无头
CHATGPT_HEADLESS=0

# 网页输入框单次最大字符数（Agent prompt 会自动截断）
CHATGPT_MAX_PROMPT_CHARS=8000

# Agent 注入的项目上下文上限（lite 模式 1.6 万对网页太大）
CHATGPT_MAX_PROJECT_CONTEXT_CHARS=4000

# =============================================================================
# Claude Code 客户端（不在 run.sh 加载，请在 ~/.claude/settings.json 或终端 export）
# =============================================================================
# ANTHROPIC_BASE_URL=http://127.0.0.1:8000
# ANTHROPIC_API_KEY=sk-any
